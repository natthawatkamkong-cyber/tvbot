      ],
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "GoldAiGradeReview"
        },
        "mode": "once",
        "options": {
          "waitForSubWorkflow": true
        }
      }
    }
