      "parameters": {
        "jsCode": "return $input.all().map((item, index) => {\n    const { symbol, direction, trendDirection } = item.json;\n    if (![\"XAUUSD\", \"XAU/USD\"].includes(symbol)) {\n      throw new Error(\"Expected XAUUSD market analysis\");\n    }\n    return {\n      json: { symbol: \"XAUUSD\", direction, trendDirection },\n      pairedItem: { item: index },\n    };\n  });"
      }
    },
    {
      "id": "a514f72d-1f4f-4c8e-9449-6bea4e490701",
      "name": "Run grading review",
      "type": "n8n-nodes-base.executeWorkflow",
